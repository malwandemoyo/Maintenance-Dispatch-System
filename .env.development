# Development environment
DJANGO_ENV=development
DEBUG=true
SECRET_KEY=django-insecure-dev-key-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=maintenance_db
DB_USER=user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432

# Email
EMAIL_BACKEND=notifications.email_backend.LoggingEmailBackend
DEFAULT_FROM_EMAIL=noreply@maintenanceservices.co.zw

# Auto-create superuser in development
AUTO_CREATE_SUPERUSER=true

# Django
DJANGO_LOG_LEVEL=INFO
