# Production environment - hardened, no auto-init
DJANGO_ENV=production
DEBUG=false
SECRET_KEY=YOUR_SECRET_KEY_HERE_CHANGE_ME_IN_PRODUCTION
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (use managed database in production)
POSTGRES_DB=maintenance_prod_db
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

DB_ENGINE=django.db.backends.postgresql
DB_NAME=maintenance_prod_db
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
DB_HOST=db
DB_PORT=5432

TIME_ZONE=Africa/Harare

# Auth Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=CHANGE_ME_PRODUCTION_AUTH_SECRET

# Frontend API Configuration
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NODE_ENV=production

# Production API URL for backend communication
PRODUCTION_API_URL=https://yourdomain.com
# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=maintenance_db
DB_USER=prod_user
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DB_HOST=db-prod.example.com
DB_PORT=5432

# Email - use real SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@maintenanceservices.co.zw

# NO auto-initialization in production
AUTO_CREATE_SUPERUSER=false

# Django
DJANGO_LOG_LEVEL=WARNING
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
