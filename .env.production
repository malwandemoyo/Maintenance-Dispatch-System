# Production environment - hardened, no auto-init
DJANGO_ENV=production
DEBUG=false
SECRET_KEY=YOUR_SECRET_KEY_HERE_CHANGE_ME_IN_PRODUCTION
FRONTEND_DOMAIN=maintanence.malwande.me
BACKEND_DOMAIN=mb.malwande.me
FRONTEND_URL=https://maintanence.malwande.me
BACKEND_URL=https://mb.malwande.me
ALLOWED_HOSTS=localhost,127.0.0.1,mb.malwande.me,backend

# Database (use managed database in production)
POSTGRES_DB=maintenance_prod_db
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

DB_ENGINE=django.db.backends.postgresql
DB_NAME=maintenance_prod_db
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_PRODUCTION_PASSWORD
DB_HOST=db
DB_PORT=5432

TIME_ZONE=Africa/Harare

# Auth Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=CHANGE_ME_PRODUCTION_AUTH_SECRET

