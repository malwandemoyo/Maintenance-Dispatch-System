# Production environment - hardened, no auto-init
DJANGO_ENV=production
DEBUG=false
SECRET_KEY=YOUR_SECRET_KEY_HERE_CHANGE_ME_IN_PRODUCTION
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=maintenance_db
DB_USER=prod_user
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DB_HOST=db-prod.example.com
DB_PORT=5432

# Email - use real SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@maintenanceservices.co.zw

# NO auto-initialization in production
AUTO_CREATE_SUPERUSER=false

# Django
DJANGO_LOG_LEVEL=WARNING
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
