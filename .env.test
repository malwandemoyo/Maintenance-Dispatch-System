# Test environment - minimal setup for CI/testing
DJANGO_ENV=test
DEBUG=true
SECRET_KEY=django-insecure-test-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Test Database (separate from dev)
POSTGRES_DB=maintenance_test_db
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_HOST_AUTH_METHOD=md5

DB_ENGINE=django.db.backends.postgresql
DB_NAME=maintenance_test_db
DB_USER=test_user
DB_PASSWORD=test_password
DB_HOST=db
DB_PORT=5432

TIME_ZONE=Africa/Harare

# Auth Secret (for tests, any value is fine)
AUTH_SECRET=test_auth_secret_do_not_use_in_production

# Frontend API Configuration (test backend)
NEXT_PUBLIC_API_URL=http://localhost:8001
NODE_ENV=testDB_PASSWORD=testpassword
DB_HOST=db
DB_PORT=5432

# Email - use memory backend for tests
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DEFAULT_FROM_EMAIL=noreply@maintenanceservices.co.zw

# Auto-create superuser
AUTO_CREATE_SUPERUSER=true

# Django
DJANGO_LOG_LEVEL=WARNING
